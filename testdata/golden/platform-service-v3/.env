# Application
APP_NAME=testproj
APP_ENV=development
APP_PORT=8080
# Header carrying the real client IP behind a proxy ('Fly-Client-IP' on fly.io).
# EMPTY locally — a direct run must trust the socket's remote address.
# ⚠️ Fiber v3 only reads this header when the connection comes from a TRUSTED
# proxy; internal/server wires TrustProxy from this value. Setting it without
# that wiring makes c.IP() silently return the PROXY's address for everyone.
APP_PROXY_HEADER=

# Logger (LOGGER_MODE: pretty|json, LOGGER_LEVEL: debug|info|warn|error|panic|disabled)
LOGGER_MODE=pretty
LOGGER_LEVEL=debug

# Graceful shutdown
GRACEFUL_VERBOSE=true
GRACEFUL_STEP_DELAY=100
GRACEFUL_SERVER_SHUTDOWN_TIMEOUT=30000

# Embedded UI (injected into index.html at render time; empty = same-origin)
VITE_API_BASE_URL=

# CORS — comma-separated browser origins allowed to call the API.
# TODO: set to the real origin(s) before deploying. Empty does NOT mean "no CORS":
# Fiber v3 treats an EMPTY AllowOrigins slice as allow-all, so the server falls
# back to the local development origins below instead.
# ⚠️ A malformed origin (missing scheme, stray character) makes Fiber v3 PANIC at
# boot rather than silently not match. That is deliberate — fix the value.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080

# Database (Postgres). Matches docker-compose.yml defaults.
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=testproj
DB_PASSWORD=testproj
DB_NAME=testproj
# ⚠️ Set EXPLICITLY, not commented out: the config struct deliberately has no
# sslmode default, so an empty DB_SSLMODE fails closed to "require" inside kuery
# — which a local docker-compose Postgres (no TLS) refuses. Only consulted when
# DB_DSN is empty; a DSN carries its own sslmode and wins outright.
DB_SSLMODE=disable
DB_DSN=
