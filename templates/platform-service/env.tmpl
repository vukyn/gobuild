# Application
APP_NAME={{.ProjectName}}
APP_ENV=development
APP_PORT=8080

# Logger (LOGGER_MODE: pretty|json, LOGGER_LEVEL: debug|info|warn|error|panic|disabled)
LOGGER_MODE=pretty
LOGGER_LEVEL=debug

# Graceful shutdown
GRACEFUL_VERBOSE=true
GRACEFUL_STEP_DELAY=100
GRACEFUL_SERVER_SHUTDOWN_TIMEOUT=30000

# Embedded UI (injected into index.html at render time; empty = same-origin)
VITE_API_BASE_URL=

# CORS — comma-separated list of browser origins allowed to call the API.
# TODO: set this to the real origin(s) before deploying. The value below is the
# Vite dev server plus the local API port; leaving it unset does NOT mean "no
# CORS", it means the server falls back to these same local origins.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080
